<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>Neon Slice 360</title>
  <!-- Load Tailwind CSS via modern CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  
  <style>
    body {
      font-family: 'Space Grotesk', sans-serif;
      background-color: #050505;
      color: #ffffff;
      margin: 0;
      overflow: hidden;
      user-select: none;
      -webkit-user-select: none;
      touch-action: none;
    }
    .neon-text-cyan {
      text-shadow: 0 0 10px #00F0FF, 0 0 20px #00F0FF;
    }
    .neon-text-magenta {
      text-shadow: 0 0 10px #FF00FF, 0 0 20px #FF00FF;
    }
    .neon-border-cyan {
      box-shadow: 0 0 15px #00F0FF, inset 0 0 5px #00F0FF;
      border-color: #00F0FF;
    }
    .neon-border-magenta {
      box-shadow: 0 0 15px #FF00FF, inset 0 0 5px #FF00FF;
      border-color: #FF00FF;
    }
    canvas {
      display: block;
      width: 100vw;
      height: 100vh;
    }
  </style>
</head>
<body class="bg-[#050505] text-white">

  <!-- Core Canvas Container -->
  <div id="canvas-container" class="absolute inset-0 z-0"></div>

  <!-- UI & Overlay HUD -->
  <div id="hud" class="absolute inset-0 pointer-events-none flex flex-col justify-between p-6 sm:p-10 z-10">
    <!-- Top Bar -->
    <div class="w-full flex justify-between items-start pointer-events-auto">
      <div class="flex flex-col">
        <div id="score-display" class="text-4xl sm:text-5xl font-bold italic tracking-tighter text-white neon-text-cyan">
          0
        </div>
        <div class="text-xs uppercase tracking-[0.3em] text-cyan-400 opacity-75 font-mono">
          Score
        </div>
      </div>

      <div class="flex gap-2" id="hearts-container">
        <!-- Rendered dynamically -->
      </div>
    </div>

    <!-- Middle: Combo & Game Screens -->
    <div class="flex-1 flex flex-col items-center justify-center">
      <!-- Combo Tracker -->
      <div id="combo-container" class="hidden flex flex-col items-center select-none transition-all scale-75 opacity-0">
        <div id="combo-text" class="text-6xl sm:text-7xl font-black italic text-cyan-400 neon-text-cyan">0x</div>
        <div class="text-xs sm:text-sm font-bold uppercase tracking-[0.3em] text-white/60">Combo</div>
      </div>

      <!-- Start Overlay -->
      <div id="start-screen" class="pointer-events-auto flex flex-col items-center gap-6 text-center max-w-lg px-4">
        <h1 class="text-6xl sm:text-8xl font-black italic tracking-tighter text-white uppercase drop-shadow-[0_0_30px_rgba(0,240,255,0.6)]">
          Neon Slice
          <span class="block text-2xl sm:text-3xl text-magenta-500 neon-text-magenta mt-1 leading-none">360 Edition</span>
        </h1>
        <p class="text-white/60 text-sm sm:text-base tracking-wide max-w-sm mb-2">
          Defend the core. Swipe & drag across incoming neon energy blocks to slash them! Look all around by dragging.
        </p>
        <button id="start-button" class="group relative px-10 py-4 bg-transparent border-2 border-cyan-400 text-cyan-400 font-bold uppercase tracking-widest transition-all duration-300 hover:bg-cyan-400 hover:text-black hover:neon-border-cyan cursor-pointer rounded">
          Initialize Matrix
        </button>
      </div>

      <!-- Game Over Overlay -->
      <div id="gameover-screen" class="hidden pointer-events-auto flex flex-col items-center gap-6 bg-black/90 p-8 sm:p-12 border border-magenta-500 backdrop-blur-xl max-w-md w-full mx-4 rounded-xl text-center shadow-[0_0_45px_rgba(255,0,255,0.3)]">
        <h2 class="text-4xl sm:text-5xl font-black italic text-magenta-500 uppercase neon-text-magenta">System Failure</h2>
        <div class="text-xl sm:text-2xl font-mono text-white/80">Final Score: <span id="final-score" class="text-cyan-400">0</span></div>
        <div class="text-sm font-mono text-white/50 mb-2">High Score: <span id="high-score" class="text-magenta-400">0</span></div>
        <button id="restart-button" class="group flex items-center justify-center gap-2 px-8 py-3 bg-magenta-500 hover:bg-magenta-400 text-black font-bold uppercase tracking-widest transition-all cursor-pointer rounded w-full">
          <i data-lucide="refresh-ccw" class="w-5 h-5"></i>
          Reboot Matrix
        </button>
      </div>
    </div>

    <!-- Bottom info -->
    <div class="w-full text-center text-[10px] font-mono uppercase tracking-[0.4em] text-white/40">
      Defensive Protocol Matrix Active // Drag to Look and Slit // Tap or hold to Slice
    </div>
  </div>

  <!-- Reticle Crosshair (Gameplay indicator) -->
  <div id="reticle-overlay" class="hidden fixed inset-0 pointer-events-none flex items-center justify-center z-5">
    <div class="w-12 h-12 border border-cyan-400/30 rounded-full flex items-center justify-center animate-pulse">
      <div class="w-1.5 h-1.5 bg-cyan-400 rounded-full shadow-[0_0_8px_#00F0FF]"></div>
    </div>
    <!-- Direction markers -->
    <div class="absolute top-1/2 -left-6 w-10 h-px bg-cyan-400/20"></div>
    <div class="absolute top-1/2 -right-6 w-10 h-px bg-cyan-400/20"></div>
    <div class="absolute -top-6 left-1/2 w-px h-10 bg-cyan-400/20"></div>
    <div class="absolute -bottom-6 left-1/2 w-px h-10 bg-cyan-400/20"></div>
  </div>

  <!-- Three.js from CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <script>
    // === GAME CONSTANTS ===
    const COLORS = {
      CYAN: 0x00F0FF,
      MAGENTA: 0xFF00FF,
      PURPLE: 0x8A2BE2,
      ELECTRIC_BLUE: 0x2E5BFF,
      DANGER_RED: 0xFF3131,
      LIGHT_GRAY: 0x666666
    };

    const CONFIG = {
      SPAWN_RADIUS: 25,
      DESPAWN_RADIUS: 2.2,
      INITIAL_SPEED: 0.08,
      SPEED_INCREMENT: 0.004,
      MAX_SPEED: 0.25,
      SPAWN_INTERVAL: 1600, // ms
      MAX_HEALTH: 3
    };

    const ENEMY_TYPES = {
      BASIC: 'BASIC',
      ARROW: 'ARROW',
      HEAVY: 'HEAVY',
      FAKE: 'FAKE'
    };

    // === STATE VARIABLES ===
    let gameState = 'START'; // 'START', 'PLAYING', 'GAMEOVER'
    let score = 0;
    let combo = 0;
    let health = CONFIG.MAX_HEALTH;
    let highScore = localStorage.getItem('neon_slice_highscore') || 0;
    
    let enemies = [];
    let speedMultiplier = 1;
    let currentSpeed = CONFIG.INITIAL_SPEED;
    let lastSpawnTime = 0;
    let globalTime = 0;

    // === AUDIO CONTEXT SYNTHESIZER ===
    let audioCtx = null;

    function initAudio() {
      if (!audioCtx) {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      }
    }

    function playAudioTone(freqStart, freqEnd, duration, type = 'sine', volume = 0.3) {
      if (!audioCtx) return;
      try {
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.type = type;
        osc.frequency.setValueAtTime(freqStart, audioCtx.currentTime);
        if (freqEnd) {
          osc.frequency.exponentialRampToValueAtTime(freqEnd, audioCtx.currentTime + duration);
        }

        gain.gain.setValueAtTime(volume, audioCtx.currentTime);
        gain.gain.linearRampToValueAtTime(0.01, audioCtx.currentTime + duration);

        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch (e) {
        console.warn("Audio error:", e);
      }
    }

    // === THREE.JS SETUP Variables ===
    let scene, camera, renderer;
    let reticle, grid, starField, pointLight1, pointLight2;
    let activeRaycaster, mousePosition;
    let isTrackingMouse = false;

    // Rotation variables (Orbit simulation manually to prevent lag on standard setup)
    let isDragging = false;
    let previousMouseX = 0;
    let previousMouseY = 0;
    let rotateY = 0;
    let rotateX = 0;

    // === DOM REFERENCES ===
    const scoreDisplay = document.getElementById('score-display');
    const heartsContainer = document.getElementById('hearts-container');
    const comboContainer = document.getElementById('combo-container');
    const comboText = document.getElementById('combo-text');
    const startScreen = document.getElementById('start-screen');
    const gameoverScreen = document.getElementById('gameover-screen');
    const finalScore = document.getElementById('final-score');
    const highScoreText = document.getElementById('high-score');
    const startButton = document.getElementById('start-button');
    const restartButton = document.getElementById('restart-button');
    const reticleOverlay = document.getElementById('reticle-overlay');
    const canvasContainer = document.getElementById('canvas-container');

    // === INITIALIZATION ===
    function init() {
      // 1. Three.js Scene Setup
      scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x050505, 0.015);

      // Camera
      camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 1000);
      camera.rotation.order = "YXZ"; // Standard flight rotation

      // Renderer
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;
      canvasContainer.appendChild(renderer.domElement);

      // Raycasting setup
      activeRaycaster = new THREE.Raycaster();
      mousePosition = new THREE.Vector2();

      // Ambient illumination
      const ambientLight = new THREE.AmbientLight(0x111122, 1.5);
      scene.add(ambientLight);

      // High-Contrast Accent Point Lights
      pointLight1 = new THREE.PointLight(COLORS.CYAN, 3, 50);
      pointLight1.position.set(15, 10, 15);
      scene.add(pointLight1);

      pointLight2 = new THREE.PointLight(COLORS.MAGENTA, 3, 50);
      pointLight2.position.set(-15, -10, -15);
      scene.add(pointLight2);

      // Build Grid Environment
      buildGridEnvironment();

      // Build Deep Field Stars
      buildStarfield();

      // Event Listeners
      window.addEventListener('resize', onWindowResize, false);
      setupInputHandlers();

      // UI Initial Setup
      updateHearts();
      lucide.createIcons();

      // Kick off animate loop
      animate();
    }

    // Build modern cyber glowing grid floor & ceiling
    function buildGridEnvironment() {
      const gridHelperBottom = new THREE.GridHelper(200, 100, COLORS.PURPLE, COLORS.ELECTRIC_BLUE);
      gridHelperBottom.position.y = -6;
      gridHelperBottom.material.opacity = 0.45;
      gridHelperBottom.material.transparent = true;
      scene.add(gridHelperBottom);

      const gridHelperTop = new THREE.GridHelper(200, 100, COLORS.PURPLE, COLORS.ELECTRIC_BLUE);
      gridHelperTop.position.y = 12;
      gridHelperTop.material.opacity = 0.25;
      gridHelperTop.material.transparent = true;
      scene.add(gridHelperTop);
    }

    // Generate beautiful particle star background
    function buildStarfield() {
      const starGeometry = new THREE.BufferGeometry();
      const starCount = 3000;
      const positions = new Float32Array(starCount * 3);
      const colors = new Float32Array(starCount * 3);

      for(let i=0; i<starCount * 3; i+=3) {
        // Distribute stars far away in a shell
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.acos((Math.random() * 2) - 1);
        const distance = 80 + Math.random() * 60;

        positions[i] = distance * Math.sin(phi) * Math.cos(theta);
        positions[i+1] = distance * Math.sin(phi) * Math.sin(theta);
        positions[i+2] = distance * Math.cos(phi);

        // Mix in cyan & magenta star flares
        const colorFactor = Math.random();
        if (colorFactor > 0.85) {
          colors[i] = 0.0; colors[i+1] = 0.94; colors[i+2] = 1.0; // Cyan tint
        } else if (colorFactor > 0.7) {
          colors[i] = 1.0; colors[i+1] = 0.0; colors[i+2] = 1.0; // Magenta tint
        } else {
          colors[i] = 0.8; colors[i+1] = 0.8; colors[i+2] = 0.9; // Base stellar
        }
      }

      starGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
      starGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));

      const starMaterial = new THREE.PointsMaterial({
        size: 0.65,
        vertexColors: true,
        transparent: true,
        opacity: 0.82,
        sizeAttenuation: true
      });

      starField = new THREE.Points(starGeometry, starMaterial);
      scene.add(starField);
    }

    // === GAME ACTIONS ===
    function startGame() {
      initAudio();

      // Sound play
      playAudioTone(220, 880, 0.4, 'triangle', 0.4);

      // Clear old state
      enemies.forEach(e => {
        scene.remove(e.mesh);
      });
      enemies = [];

      score = 0;
      combo = 0;
      health = CONFIG.MAX_HEALTH;
      currentSpeed = CONFIG.INITIAL_SPEED;
      
      scoreDisplay.textContent = score;
      updateHearts();

      gameState = 'PLAYING';

      // Dom transition
      startScreen.classList.add('hidden');
      gameoverScreen.classList.add('hidden');
      reticleOverlay.classList.remove('hidden');
      comboContainer.classList.add('hidden');
    }

    function gameOver() {
      gameState = 'GAMEOVER';
      playAudioTone(150, 60, 0.6, 'sawtooth', 0.5);
      
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('neon_slice_highscore', highScore);
      }

      finalScore.textContent = score;
      highScoreText.textContent = highScore;

      reticleOverlay.classList.add('hidden');
      gameoverScreen.classList.remove('hidden');
      comboContainer.classList.add('hidden');
    }

    function updateHearts() {
      heartsContainer.innerHTML = '';
      for (let i = 0; i < CONFIG.MAX_HEALTH; i++) {
        const h = document.createElement('div');
        h.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="${i < health ? '#FF00FF' : 'none'}" stroke="${i < health ? '#FF00FF' : '#333344'}" stroke-width="2" class="${i < health ? 'drop-shadow-[0_0_8px_#FF00FF]' : ''}"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
        heartsContainer.appendChild(h);
      }
    }

    // === ENEMY LOGIC & GEOMETRY GENERATOR ===
    function spawnEnemy() {
      const angle = Math.random() * Math.PI * 2;
      const height = (Math.random() - 0.5) * 6; // Limit height bounds to gameplay vision

      // Spawn in a clean radial sphere around client coordinates
      const x = Math.cos(angle) * CONFIG.SPAWN_RADIUS;
      const z = Math.sin(angle) * CONFIG.SPAWN_RADIUS;
      const y = height;

      // Type picker logic matches original project schema
      const typeRoll = Math.random();
      let enemyType = ENEMY_TYPES.BASIC;
      if (typeRoll > 0.70) enemyType = ENEMY_TYPES.ARROW;
      if (typeRoll > 0.85) enemyType = ENEMY_TYPES.HEAVY;
      if (typeRoll > 0.95) enemyType = ENEMY_TYPES.FAKE;

      // Build target materials and geo
      let geometry, material, mesh;
      let colorValue = COLORS.MAGENTA;
      let lightPower = 2.0;

      if (enemyType === ENEMY_TYPES.FAKE) {
        colorValue = COLORS.DANGER_RED;
        geometry = new THREE.SphereGeometry(0.85, 16, 16);
        lightPower = 4.0;
      } else if (enemyType === ENEMY_TYPES.HEAVY) {
        colorValue = COLORS.PURPLE;
        geometry = new THREE.BoxGeometry(1.4, 1.4, 1.4);
        lightPower = 3.5;
      } else if (enemyType === ENEMY_TYPES.ARROW) {
        colorValue = COLORS.CYAN;
        // Construct arrow mesh grouping for classic visuals
        geometry = new THREE.BoxGeometry(1.0, 1.0, 1.0);
        lightPower = 2.5;
      } else {
        colorValue = COLORS.MAGENTA;
        geometry = new THREE.BoxGeometry(1.0, 1.0, 1.0);
      }

      material = new THREE.MeshBasicMaterial({
        color: colorValue,
        transparent: true,
        opacity: 0.95,
        wireframe: (enemyType === ENEMY_TYPES.HEAVY) ? false : true // wireframe for synth pop aesthetic
      });

      if (enemyType === ENEMY_TYPES.HEAVY) {
        mesh = new THREE.Group();
        const mainMesh = new THREE.Mesh(geometry, material);
        const edges = new THREE.EdgesGeometry(geometry);
        const edgeLine = new THREE.LineSegments(edges, new THREE.LineBasicMaterial({ color: 0xffffff }));
        mesh.add(mainMesh);
        mesh.add(edgeLine);
      } else if (enemyType === ENEMY_TYPES.ARROW) {
        mesh = new THREE.Group();
        const baseBox = new THREE.Mesh(geometry, material);
        mesh.add(baseBox);

        // Add direction indicators
        const arrowGeo = new THREE.ConeGeometry(0.3, 0.7, 4);
        const arrowMat = new THREE.MeshBasicMaterial({ color: 0xffffff });
        const arrowMesh = new THREE.Mesh(arrowGeo, arrowMat);
        arrowMesh.position.set(0, 0, 0.6);
        arrowMesh.rotation.x = Math.PI / 2;
        mesh.add(arrowMesh);
      } else {
        mesh = new THREE.Mesh(geometry, material);
      }

      // Initial placement & tracking variables
      mesh.position.set(x, y, z);
      scene.add(mesh);

      // Store matching metadata structure for vector comparisons
      const directionVector = new THREE.Vector3(-x, -y, -z).normalize();
      
      enemies.push({
        id: Math.random().toString(36).substr(2, 9),
        type: enemyType,
        mesh: mesh,
        direction: directionVector,
        speed: currentSpeed,
        health: (enemyType === ENEMY_TYPES.HEAVY) ? 2 : 1
      });
    }

    // Handle collision / interaction
    function performSlice(enemyMatched) {
      if (gameState !== 'PLAYING') return;

      const idx = enemies.indexOf(enemyMatched);
      if (idx === -1) return;

      createNeonExplosion(enemyMatched.mesh.position, enemyMatched.type);

      if (enemyMatched.type === ENEMY_TYPES.FAKE) {
        // Red alert bomb - hit penalty
        playAudioTone(180, 50, 0.35, 'sawtooth', 0.4);
        health -= 1;
        combo = 0;
        updateHearts();
        flashScreenRed();
        
        scene.remove(enemyMatched.mesh);
        enemies.splice(idx, 1);

        if (health <= 0) gameOver();
      } else {
        enemyMatched.health -= 1;
        
        if (enemyMatched.health <= 0) {
          // Play slide slice synth sound
          playAudioTone(600, 200, 0.15, 'triangle', 0.25);

          score += 100 * (Math.floor(combo / 10) + 1);
          scoreDisplay.textContent = score;
          
          combo += 1;
          updateComboDisplay();

          scene.remove(enemyMatched.mesh);
          enemies.splice(idx, 1);
        } else {
          // Heavy piece hit feedback tone
          playAudioTone(300, 150, 0.1, 'sawtooth', 0.2);
          enemyMatched.mesh.scale.set(0.7, 0.7, 0.7);
        }
      }
    }

    // === COMBOS, PARTICLES & SATISFYING FEEDBACK ===
    function updateComboDisplay() {
      if (combo > 1) {
        comboContainer.style.display = 'flex';
        comboContainer.classList.remove('hidden');
        comboContainer.style.opacity = '1';
        comboContainer.style.transform = 'scale(1.1)';
        comboText.textContent = combo + 'x';
        
        setTimeout(() => {
          comboContainer.style.transform = 'scale(1.0)';
        }, 150);
      } else {
        comboContainer.classList.add('hidden');
      }
    }

    function flashScreenRed() {
      document.body.style.backgroundColor = '#400010';
      setTimeout(() => {
        document.body.style.backgroundColor = '#050505';
      }, 150);
    }

    // Aesthetic neon slice burst simulation particles
    function createNeonExplosion(pos, type) {
      const particleCount = 20;
      const particleGeo = new THREE.BufferGeometry();
      const pPositions = new Float32Array(particleCount * 3);
      const velocities = [];

      let particleColorHex = COLORS.MAGENTA;
      if (type === ENEMY_TYPES.ARROW) particleColorHex = COLORS.CYAN;
      if (type === ENEMY_TYPES.FAKE) particleColorHex = COLORS.DANGER_RED;
      if (type === ENEMY_TYPES.HEAVY) particleColorHex = COLORS.PURPLE;

      for (let i = 0; i < particleCount; i++) {
        pPositions[i*3] = pos.x;
        pPositions[i*3+1] = pos.y;
        pPositions[i*3+2] = pos.z;

        velocities.push({
          x: (Math.random() - 0.5) * 6,
          y: (Math.random() - 0.5) * 6,
          z: (Math.random() - 0.5) * 6
        });
      }

      particleGeo.setAttribute('position', new THREE.BufferAttribute(pPositions, 3));
      
      const particleMat = new THREE.PointsMaterial({
        color: particleColorHex,
        size: 0.45,
        transparent: true,
        opacity: 0.95
      });

      const particles = new THREE.Points(particleGeo, particleMat);
      scene.add(particles);

      let pTimer = 0;
      function animateParticles() {
        if (pTimer > 35) {
          scene.remove(particles);
          return;
        }

        const currentPositions = particles.geometry.attributes.position.array;
        for (let i = 0; i < particleCount; i++) {
          currentPositions[i*3] += velocities[i].x * 0.05;
          currentPositions[i*3+1] += velocities[i].y * 0.05;
          currentPositions[i*3+2] += velocities[i].z * 0.05;
        }
        particles.geometry.attributes.position.needsUpdate = true;
        particleMat.opacity *= 0.92;

        pTimer++;
        requestAnimationFrame(animateParticles);
      }
      animateParticles();
    }

    // === GAME CONTROL IMPLEMENTATION ===
    function setupInputHandlers() {
      // Mouse dragging look & slash interaction
      window.addEventListener('mousedown', (e) => {
        initAudio(); // Audio activation context gesture
        isDragging = true;
        previousMouseX = e.clientX;
        previousMouseY = e.clientY;

        testRaycastInteraction(e);
      });

      window.addEventListener('mousemove', (e) => {
        if (isDragging) {
          const deltaX = e.clientX - previousMouseX;
          const deltaY = e.clientY - previousMouseY;

          rotateY -= deltaX * 0.005;
          rotateX -= deltaY * 0.005;

          // Clamping bounds to prevent upside down loop flips
          rotateX = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, rotateX));

          camera.rotation.y = rotateY;
          camera.rotation.x = rotateX;

          previousMouseX = e.clientX;
          previousMouseY = e.clientY;

          // Drag sweeping slash check!
          testRaycastInteraction(e);
        }
      });

      window.addEventListener('mouseup', () => {
        isDragging = false;
      });

      // Mobile touch interfaces mapping
      window.addEventListener('touchstart', (e) => {
        initAudio();
        isDragging = true;
        const touch = e.touches[0];
        previousMouseX = touch.clientX;
        previousMouseY = touch.clientY;
        testRaycastInteraction(touch);
      });

      window.addEventListener('touchmove', (e) => {
        if (isDragging && e.touches.length > 0) {
          const touch = e.touches[0];
          const deltaX = touch.clientX - previousMouseX;
          const deltaY = touch.clientY - previousMouseY;

          rotateY -= deltaX * 0.006;
          rotateX -= deltaY * 0.006;
          rotateX = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, rotateX));

          camera.rotation.y = rotateY;
          camera.rotation.x = rotateX;

          previousMouseX = touch.clientX;
          previousMouseY = touch.clientY;

          // Screen swipe slash check!
          testRaycastInteraction(touch);
        }
      });

      window.addEventListener('touchend', () => {
        isDragging = false;
      });

      // HTML Interface Triggers
      startButton.addEventListener('click', startGame);
      restartButton.addEventListener('click', startGame);
    }

    function testRaycastInteraction(eventPointer) {
      if (gameState !== 'PLAYING') return;

      // Update pointer standard coordinates
      mousePosition.x = (eventPointer.clientX / window.innerWidth) * 2 - 1;
      mousePosition.y = -(eventPointer.clientY / window.innerHeight) * 2 + 1;

      activeRaycaster.setFromCamera(mousePosition, camera);

      // Get list of targets in path
      const activeTargets = [];
      enemies.forEach(e => {
        if (e.mesh) {
          activeTargets.push(e.mesh);
        }
      });

      const targetIntersects = activeRaycaster.intersectObjects(activeTargets, true);

      if (targetIntersects.length > 0) {
        // Resolve closest matching target index
        const firstHitMesh = targetIntersects[0].object;
        
        // Find matching enemy source in logic array
        const hitEnemy = enemies.find(e => {
          if (e.mesh === firstHitMesh) return true;
          if (e.mesh.children && e.mesh.children.includes(firstHitMesh)) return true;
          // Check deeper level nested groups
          let matchFound = false;
          if (e.mesh.children) {
            e.mesh.children.forEach(child => {
              if (child === firstHitMesh) matchFound = true;
              if (child.children && child.children.includes(firstHitMesh)) matchFound = true;
            });
          }
          return matchFound;
        });

        if (hitEnemy) {
          performSlice(hitEnemy);
        }
      }
    }

    // Handle viewport shifts cleanly
    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    // === ENGINE TICKER & CORE LOOP ===
    function animate() {
      requestAnimationFrame(animate);

      globalTime += 0.01;

      // 1. Spawning dynamic logic
      if (gameState === 'PLAYING') {
        const now = Date.now();
        if (now - lastSpawnTime > CONFIG.SPAWN_INTERVAL) {
          spawnEnemy();
          lastSpawnTime = now;

          // Slowly scale velocity up on high progression
          currentSpeed = Math.min(CONFIG.MAX_SPEED, currentSpeed + CONFIG.SPEED_INCREMENT);
        }
      }

      // 2. Active elements physics adjustments
      for (let i = enemies.length - 1; i >= 0; i--) {
        const enemy = enemies[i];

        // Move targets radially towards coordinate center
        enemy.mesh.position.addScaledVector(enemy.direction, enemy.speed);

        // Slow aesthetic float rotation simulation
        enemy.mesh.rotation.y += 0.02;
        enemy.mesh.rotation.x += 0.01;

        // Visual tracking logic check: if reached standard buffer perimeter zone
        const distToCenter = enemy.mesh.position.length();

        if (distToCenter < CONFIG.DESPAWN_RADIUS) {
          // Despawn & handle score penalty checks loop safely
          scene.remove(enemy.mesh);
          enemies.splice(i, 1);

          if (enemy.type !== ENEMY_TYPES.FAKE) {
            playAudioTone(100, 50, 0.3, 'sawtooth', 0.4);
            flashScreenRed();
            health -= 1;
            combo = 0;
            updateHearts();
            updateComboDisplay();

            if (health <= 0) {
              gameOver();
            }
          }
        }
      }

      // Dynamic scene updates (slow pulse visuals)
      pointLight1.intensity = 3 + Math.sin(globalTime * 3) * 1;
      pointLight2.intensity = 3 + Math.cos(globalTime * 3) * 1;

      renderer.render(scene, camera);
    }

    // Run matrix
    init();
  </script>
</body>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Neon Slice 360 - Standalone Edition</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body {
      font-family: 'Space Grotesk', sans-serif;
      background-color: #050505;
      color: #ffffff;
      margin: 0;
      overflow: hidden;
      user-select: none;
    }
    .neon-text-cyan { text-shadow: 0 0 10px #00F0FF, 0 0 20px #00F0FF; }
    .neon-text-magenta { text-shadow: 0 0 10px #FF00FF, 0 0 20px #FF00FF; }
    .neon-border-cyan { box-shadow: 0 0 15px #00F0FF, inset 0 0 5px #00F0FF; border-color: #00F0FF; }
    .neon-border-magenta { box-shadow: 0 0 15px #FF00FF, inset 0 0 5px #FF00FF; border-color: #FF00FF; }
    canvas { display: block; width: 100vw; height: 100vh; }
  </style>
</head>
<body class="bg-[#050505] text-white">
  <div id="canvas-container" class="absolute inset-0 z-0"></div>
  <div id="hud" class="absolute inset-0 pointer-events-none flex flex-col justify-between p-6 sm:p-10 z-10">
    <div class="w-full flex justify-between items-start pointer-events-auto">
      <div class="flex flex-col">
        <div id="score-display" class="text-4xl sm:text-5xl font-bold italic tracking-tighter text-white neon-text-cyan">0</div>
        <div class="text-xs uppercase tracking-[0.3em] text-cyan-400 opacity-75 font-mono">Score</div>
      </div>
      <div class="flex gap-2" id="hearts-container"></div>
    </div>
    <div class="flex-1 flex flex-col items-center justify-center">
      <div id="combo-container" class="hidden flex flex-col items-center select-none transition-all scale-75 opacity-0">
        <div id="combo-text" class="text-6xl sm:text-7xl font-black italic text-cyan-400 neon-text-cyan">0x</div>
        <div class="text-xs sm:text-sm font-bold uppercase tracking-[0.3em] text-white/60">Combo</div>
      </div>
      <div id="start-screen" class="pointer-events-auto flex flex-col items-center gap-6 text-center max-w-lg px-4">
        <h1 class="text-6xl sm:text-8xl font-black italic tracking-tighter text-white uppercase drop-shadow-[0_0_30px_rgba(0,240,255,0.6)]">
          Neon Slice <span class="block text-2xl sm:text-3xl text-magenta-500 neon-text-magenta mt-1 leading-none">360 Edition</span>
        </h1>
        <p class="text-white/60 text-sm sm:text-base tracking-wide max-w-sm mb-2">
          Defend the core. Look all around you by dragging. Click incoming neon energy blocks to slice them!
        </p>
        <button id="start-button" class="group relative px-10 py-4 bg-transparent border-2 border-cyan-400 text-cyan-400 font-bold uppercase tracking-widest transition-all duration-300 hover:bg-cyan-400 hover:text-black hover:neon-border-cyan cursor-pointer rounded">
          Initialize Matrix
        </button>
      </div>
      <div id="gameover-screen" class="hidden pointer-events-auto flex flex-col items-center gap-6 bg-black/90 p-8 sm:p-12 border border-magenta-500 backdrop-blur-xl max-w-md w-full mx-4 rounded-xl text-center shadow-[0_0_45px_rgba(255,0,255,0.3)]">
        <h2 class="text-4xl sm:text-5xl font-black italic text-magenta-500 uppercase neon-text-magenta">System Failure</h2>
        <div class="text-xl sm:text-2xl font-mono text-white/80">Final Score: <span id="final-score" class="text-cyan-400">0</span></div>
        <div class="text-sm font-mono text-white/50 mb-2">High Score: <span id="high-score" class="text-magenta-400">0</span></div>
        <button id="restart-button" class="group flex items-center justify-center gap-2 px-8 py-3 bg-magenta-500 hover:bg-magenta-400 text-black font-bold uppercase tracking-widest transition-all cursor-pointer rounded w-full">
          <i data-lucide="refresh-ccw" class="w-5 h-5"></i> Reboot Matrix
        </button>
      </div>
    </div>
    <div class="w-full text-center text-[10px] font-mono uppercase tracking-[0.4em] text-white/40">
      Defensive Protocol Matrix Active // Drag to Look Around // Click to Slice
    </div>
  </div>

  <div id="reticle-overlay" class="hidden fixed inset-0 pointer-events-none flex items-center justify-center z-5">
    <div class="w-12 h-12 border border-cyan-400/30 rounded-full flex items-center justify-center animate-pulse">
      <div class="w-1.5 h-1.5 bg-cyan-400 rounded-full shadow-[0_0_8px_#00F0FF]"></div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script>
    const COLORS = { CYAN: 0x00F0FF, MAGENTA: 0xFF00FF, PURPLE: 0x8A2BE2, ELECTRIC_BLUE: 0x2E5BFF, DANGER_RED: 0xFF3131 };
    const CONFIG = { SPAWN_RADIUS: 25, DESPAWN_RADIUS: 2.2, INITIAL_SPEED: 0.08, SPEED_INCREMENT: 0.004, MAX_SPEED: 0.25, SPAWN_INTERVAL: 1600, MAX_HEALTH: 3 };
    const ENEMY_TYPES = { BASIC: 'BASIC', ARROW: 'ARROW', HEAVY: 'HEAVY', FAKE: 'FAKE' };

    let gameState = 'START', score = 0, combo = 0, health = CONFIG.MAX_HEALTH, highSore = localStorage.getItem('neon_slice_highscore') || 0;
    let enemies = [], currentSpeed = CONFIG.INITIAL_SPEED, lastSpawnTime = 0, globalTime = 0, scene, camera, renderer, pointLight1, pointLight2, activeRaycaster, mousePosition;
    let isDragging = false, previousMouseX = 0, previousMouseY = 0, rotateY = 0, rotateX = 0;

    const scoreDisplay = document.getElementById('score-display'), heartsContainer = document.getElementById('hearts-container'), comboContainer = document.getElementById('combo-container'), comboText = document.getElementById('combo-text'), startScreen = document.getElementById('start-screen'), gameoverScreen = document.getElementById('gameover-screen'), finalScore = document.getElementById('final-score'), highScoreText = document.getElementById('high-score'), startButton = document.getElementById('start-button'), restartButton = document.getElementById('restart-button'), reticleOverlay = document.getElementById('reticle-overlay'), canvasContainer = document.getElementById('canvas-container');

    function init() {
      scene = new THREE.Scene(); scene.fog = new THREE.FogExp2(0x050505, 0.015);
      camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 1000); camera.rotation.order = "YXZ";
      renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false }); renderer.setSize(window.innerWidth, window.innerHeight); renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); canvasContainer.appendChild(renderer.domElement);
      activeRaycaster = new THREE.Raycaster(); mousePosition = new THREE.Vector2();
      scene.add(new THREE.AmbientLight(0x111122, 1.5));
      pointLight1 = new THREE.PointLight(COLORS.CYAN, 3, 50); pointLight1.position.set(15, 10, 15); scene.add(pointLight1);
      pointLight2 = new THREE.PointLight(COLORS.MAGENTA, 3, 50); pointLight2.position.set(-15, -10, -15); scene.add(pointLight2);

      const gridHelperBottom = new THREE.GridHelper(200, 100, COLORS.PURPLE, COLORS.ELECTRIC_BLUE); gridHelperBottom.position.y = -6; gridHelperBottom.material.opacity = 0.45; gridHelperBottom.material.transparent = true; scene.add(gridHelperBottom);
      const gridHelperTop = new THREE.GridHelper(200, 100, COLORS.PURPLE, COLORS.ELECTRIC_BLUE); gridHelperTop.position.y = 12; gridHelperTop.material.opacity = 0.25; gridHelperTop.material.transparent = true; scene.add(gridHelperTop);

      buildStarfield(); window.addEventListener('resize', onWindowResize, false); setupInputHandlers(); updateHearts(); lucide.createIcons(); animate();
    }

    function buildStarfield() {
      const starGeometry = new THREE.BufferGeometry(), starCount = 3000, positions = new Float32Array(starCount * 3), colors = new Float32Array(starCount * 3);
      for(let i=0; i<starCount * 3; i+=3) {
        const theta = Math.random() * Math.PI * 2, phi = Math.acos((Math.random() * 2) - 1), distance = 80 + Math.random() * 60;
        positions[i] = distance * Math.sin(phi) * Math.cos(theta); positions[i+1] = distance * Math.sin(phi) * Math.sin(theta); positions[i+2] = distance * Math.cos(phi);
        const colorFactor = Math.random();
        if (colorFactor > 0.85) { colors[i] = 0.0; colors[i+1] = 0.94; colors[i+2] = 1.0; }
        else if (colorFactor > 0.7) { colors[i] = 1.0; colors[i+1] = 0.0; colors[i+2] = 1.0; }
        else { colors[i] = 0.8; colors[i+1] = 0.8; colors[i+2] = 0.9; }
      }
      starGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3)); starGeometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
      starField = new THREE.Points(starGeometry, new THREE.PointsMaterial({ size: 0.65, vertexColors: true, transparent: true, opacity: 0.82 })); scene.add(starField);
    }

    function startGame() {
      enemies.forEach(e => scene.remove(e.mesh)); enemies = []; score = 0; combo = 0; health = CONFIG.MAX_HEALTH; currentSpeed = CONFIG.INITIAL_SPEED;
      scoreDisplay.textContent = score; updateHearts(); gameState = 'PLAYING';
      startScreen.classList.add('hidden'); gameoverScreen.classList.add('hidden'); reticleOverlay.classList.remove('hidden'); comboContainer.classList.add('hidden');
    }

    function gameOver() {
      gameState = 'GAMEOVER'; if (score > highSore) { highSore = score; localStorage.setItem('neon_slice_highscore', highSore); }
      finalScore.textContent = score; highScoreText.textContent = highSore;
      reticleOverlay.classList.add('hidden'); gameoverScreen.classList.remove('hidden'); comboContainer.classList.add('hidden');
    }

    function updateHearts() {
      heartsContainer.innerHTML = '';
      for (let i = 0; i < CONFIG.MAX_HEALTH; i++) {
        const h = document.createElement('div');
        h.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="${i < health ? '#FF00FF' : 'none'}" stroke="${i < health ? '#FF00FF' : '#333344'}" stroke-width="2"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`;
        heartsContainer.appendChild(h);
      }
    }

    function spawnEnemy() {
      const angle = Math.random() * Math.PI * 2, height = (Math.random() - 0.5) * 6;
      const x = Math.cos(angle) * CONFIG.SPAWN_RADIUS, z = Math.sin(angle) * CONFIG.SPAWN_RADIUS, y = height;
      const typeRoll = Math.random(); let enemyType = ENEMY_TYPES.BASIC;
      if (typeRoll > 0.70) enemyType = ENEMY_TYPES.ARROW;
      if (typeRoll > 0.85) enemyType = ENEMY_TYPES.HEAVY;
      if (typeRoll > 0.95) enemyType = ENEMY_TYPES.FAKE;

      let geometry, material, mesh, colorValue = COLORS.MAGENTA;
      if (enemyType === ENEMY_TYPES.FAKE) { colorValue = COLORS.DANGER_RED; geometry = new THREE.SphereGeometry(0.85, 16, 16); }
      else if (enemyType === ENEMY_TYPES.HEAVY) { colorValue = COLORS.PURPLE; geometry = new THREE.BoxGeometry(1.4, 1.4, 1.4); }
      else { colorValue = COLORS.CYAN; geometry = new THREE.BoxGeometry(1.0, 1.0, 1.0); }

      material = new THREE.MeshBasicMaterial({ color: colorValue, transparent: true, opacity: 0.95, wireframe: enemyType !== ENEMY_TYPES.HEAVY });
      mesh = new THREE.Mesh(geometry, material); mesh.position.set(x, y, z); scene.add(mesh);

      enemies.push({ id: Math.random().toString(36).substr(2, 9), type: enemyType, mesh: mesh, direction: new THREE.Vector3(-x, -y, -z).normalize(), speed: currentSpeed, health: enemyType === ENEMY_TYPES.HEAVY ? 2 : 1 });
    }

    function performSlice(enemyMatched) {
      if (gameState !== 'PLAYING') return;
      const idx = enemies.indexOf(enemyMatched); if (idx === -1) return;
      createNeonExplosion(enemyMatched.mesh.position, enemyMatched.type);

      if (enemyMatched.type === ENEMY_TYPES.FAKE) {
        health -= 1; combo = 0; updateHearts(); flashScreenRed();
        scene.remove(enemyMatched.mesh); enemies.splice(idx, 1);
        if (health <= 0) gameOver();
      } else {
        enemyMatched.health -= 1;
        if (enemyMatched.health <= 0) {
          score += 100 * (Math.floor(combo / 10) + 1); scoreDisplay.textContent = score;
          combo += 1; updateComboDisplay(); scene.remove(enemyMatched.mesh); enemies.splice(idx, 1);
        } else {
          enemyMatched.mesh.scale.set(0.7, 0.7, 0.7);
        }
      }
    }

    function updateComboDisplay() {
      if (combo > 1) { comboContainer.style.display = 'flex'; comboContainer.classList.remove('hidden'); comboContainer.style.opacity = '1'; comboText.textContent = combo + 'x'; }
      else { comboContainer.classList.add('hidden'); }
    }

    function flashScreenRed() { document.body.style.backgroundColor = '#400010'; setTimeout(() => document.body.style.backgroundColor = '#050505', 150); }

    function createNeonExplosion(pos, type) {
      const particleCount = 20, particleGeo = new THREE.BufferGeometry(), pPositions = new Float32Array(particleCount * 3), velocities = [];
      let particleColorHex = COLORS.MAGENTA;
      if (type === ENEMY_TYPES.ARROW) particleColorHex = COLORS.CYAN;
      if (type === ENEMY_TYPES.FAKE) particleColorHex = COLORS.DANGER_RED;

      for (let i = 0; i < particleCount; i++) {
        pPositions[i*3] = pos.x; pPositions[i*3+1] = pos.y; pPositions[i*3+2] = pos.z;
        velocities.push({ x: (Math.random() - 0.5) * 6, y: (Math.random() - 0.5) * 6, z: (Math.random() - 0.5) * 6 });
      }
      particleGeo.setAttribute('position', new THREE.BufferAttribute(pPositions, 3));
      const particleMat = new THREE.PointsMaterial({ color: particleColorHex, size: 0.45, transparent: true, opacity: 0.95 });
      const particles = new THREE.Points(particleGeo, particleMat); scene.add(particles);

      let pTimer = 0;
      function animateParticles() {
        if (pTimer > 35) { scene.remove(particles); return; }
        const currentPositions = particles.geometry.attributes.position.array;
        for (let i = 0; i < particleCount; i++) {
          currentPositions[i*3] += velocities[i].x * 0.05; currentPositions[i*3+1] += velocities[i].y * 0.05; currentPositions[i*3+2] += velocities[i].z * 0.05;
        }
        particles.geometry.attributes.position.needsUpdate = true; particleMat.opacity *= 0.92; pTimer++; requestAnimationFrame(animateParticles);
      }
      animateParticles();
    }

    function setupInputHandlers() {
      window.addEventListener('mousedown', (e) => { isDragging = true; previousMouseX = e.clientX; previousMouseY = e.clientY; testRaycastInteraction(e); });
      window.addEventListener('mousemove', (e) => {
        if (isDragging) {
          rotateY -= (e.clientX - previousMouseX) * 0.005; rotateX -= (e.clientY - previousMouseY) * 0.005;
          rotateX = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, rotateX));
          camera.rotation.y = rotateY; camera.rotation.x = rotateX;
          previousMouseX = e.clientX; previousMouseY = e.clientY;
        }
      });
      window.addEventListener('mouseup', () => isDragging = false);
      window.addEventListener('touchstart', (e) => { isDragging = true; const touch = e.touches[0]; previousMouseX = touch.clientX; previousMouseY = touch.clientY; testRaycastInteraction(touch); });
      window.addEventListener('touchmove', (e) => {
        if (isDragging && e.touches.length > 0) {
          const touch = e.touches[0];
          rotateY -= (touch.clientX - previousMouseX) * 0.006; rotateX -= (touch.clientY - previousMouseY) * 0.006;
          rotateX = Math.max(-Math.PI / 4, Math.min(Math.PI / 4, rotateX));
          camera.rotation.y = rotateY; camera.rotation.x = rotateX;
          previousMouseX = touch.clientX; previousMouseY = touch.clientY;
        }
      });
      window.addEventListener('touchend', () => isDragging = false);
      startButton.addEventListener('click', startGame); restartButton.addEventListener('click', startGame);
    }

    function testRaycastInteraction(eventPointer) {
      if (gameState !== 'PLAYING') return;
      mousePosition.x = (eventPointer.clientX / window.innerWidth) * 2 - 1; mousePosition.y = -(eventPointer.clientY / window.innerHeight) * 2 + 1;
      activeRaycaster.setFromCamera(mousePosition, camera);
      const activeTargets = enemies.map(e => e.mesh), targetIntersects = activeRaycaster.intersectObjects(activeTargets, true);
      if (targetIntersects.length > 0) {
        const hitEnemy = enemies.find(e => e.mesh === targetIntersects[0].object);
        if (hitEnemy) performSlice(hitEnemy);
      }
    }

    function onWindowResize() { camera.aspect = window.innerWidth / window.innerHeight; camera.updateProjectionMatrix(); renderer.setSize(window.innerWidth, window.innerHeight); }

    function animate() {
      requestAnimationFrame(animate); globalTime += 0.01;
      if (gameState === 'PLAYING') {
        const now = Date.now();
        if (now - lastSpawnTime > CONFIG.SPAWN_INTERVAL) { spawnEnemy(); lastSpawnTime = now; currentSpeed = Math.min(CONFIG.MAX_SPEED, currentSpeed + CONFIG.SPEED_INCREMENT); }
      }
      for (let i = enemies.length - 1; i >= 0; i--) {
        const enemy = enemies[i]; enemy.mesh.position.addScaledVector(enemy.direction, enemy.speed);
        enemy.mesh.rotation.y += 0.02; enemy.mesh.rotation.x += 0.01;
        if (enemy.mesh.position.length() < CONFIG.DESPAWN_RADIUS) {
          scene.remove(enemy.mesh); enemies.splice(i, 1);
          if (enemy.type !== ENEMY_TYPES.FAKE) { flashScreenRed(); health -= 1; combo = 0; updateHearts(); updateComboDisplay(); if (health <= 0) gameOver(); }
        }
      }
      pointLight1.intensity = 3 + Math.sin(globalTime * 3); pointLight2.intensity = 3 + Math.cos(globalTime * 3);
      renderer.render(scene, camera);
    }
    init();
  </script>
</body>
</html>
